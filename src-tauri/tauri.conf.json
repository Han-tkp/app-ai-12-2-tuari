{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropDetect AI",
  "version": "2.0.4",
  "identifier": "com.h4n.dropdetect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DropDetect AI",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    },
    "longDescription": "DropDetect AI - Professional desktop application for real-time chemical spray droplet analysis per WHO standards",
    "shortDescription": "DropDetect AI - Droplet Analysis",
    "copyright": "Copyright (c) 2024-2026 DropDetect AI",
    "category": "Utility",
    "resources": [
      "../fileonnx/*",
      "../resources/*"
    ]
  },
  "plugins": {
    "camera": {
      "enabled": true
    }
  }
}
